# PostgreSQL
# docker composeで動かす場合、DATABASE_URL/REDIS_ADDRはdocker-compose.yaml
# 側でサービス名(postgres/redis)を指す値に上書きされる。ここの値は素の
# Goバイナリをホストで直接動かす開発フロー用。
DATABASE_URL=postgres://knives:knives@localhost:5432/knives?sslmode=disable

# Redis (キャッシュ / セッション / Streams)
REDIS_ADDR=localhost:6379

# HTTPサーバ
API_LISTEN_ADDR=:8080
REDIRECT_LISTEN_ADDR=:8081
# web/ のSPA公開URL。確認メール(3.4節・3.1節)内のリンクはここを指す。
# api/redirect/webを1つのFQDNへ統合する構成(docker-compose.yaml、
# deploy/nginx/nginx.conf)では、WEB_PUBLIC_BASE_URLと
# API_PUBLIC_BASE_URLは同一オリジンになる(docker-compose.yaml側で
# http://knives.localhost:${PROXY_PORT}に上書きされる)。ページへの
# リンクにはcmd/api側で/appプレフィックスが付加される
# (SPAは/app配下に統合されているため、docs/architecture.md参照)。
# WEB_PUBLIC_BASE_URLはWebAuthnのRPID/RPOrigins算出にも使うため、
# パスを含まないオリジンのみを設定すること。
WEB_PUBLIC_BASE_URL=http://localhost:5173
# このAPIサーバ自身の外部到達可能なURL。SAMLのSP EntityID/ACS URL(3.2節)は
# SPAではなくこのAPIを指すため別に持つ
API_PUBLIC_BASE_URL=http://localhost:8080

# api/redirect/webを1つのFQDNへ統合するリバースプロキシ(nginx)が
# ホストに公開するポート。docker compose使用時のみ参照される
# (docker-compose.yaml)。既定80ではなく8000を選んでいるのは、
# 環境によって80番ポートが権限/競合の問題を起こしうるため。
PROXY_PORT=8000

# セッション(サーバサイドセッション、5.2節)
SESSION_COOKIE_NAME=knives_session
SESSION_TTL=24h
# 本番は必ずtrue(HTTPS前提)。ローカルでHTTP開発する場合のみfalseにする。
SESSION_COOKIE_SECURE=true

# click_events.ip_hash 用ソルト(推測困難な値を各環境で生成すること)
IP_HASH_SALT=

# GeoIP(国別統計、4節)用のMaxMind GeoIP2/GeoLite2 Country形式.mmdbファイル
# パス。未設定の場合はcountry_codeが常にNULLになる(GeoIP機能を使わない
# 場合は空のままでよい)。データベース自体はこのリポジトリに含まれない
# ため、MaxMind等から別途取得すること
GEOIP_DB_PATH=

# OIDCのclient_secret暗号化キー(idp_oidc_configs.client_secret_encrypted、
# AES-256-GCM)。32バイトをbase64エンコードした値(例: `openssl rand -base64 32`)。
# 各環境で生成し、絶対にコミットしないこと
CREDENTIAL_ENCRYPTION_KEY=

# メール送信(確認メール、3.4節のアカウント統合フロー用)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

# ログレベル
LOG_LEVEL=info
