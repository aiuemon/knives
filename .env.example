# PostgreSQL
DATABASE_URL=postgres://knives:knives@localhost:5432/knives?sslmode=disable

# Redis (キャッシュ / セッション / Streams)
REDIS_ADDR=localhost:6379

# HTTPサーバ
API_LISTEN_ADDR=:8080
REDIRECT_LISTEN_ADDR=:8081

# セッション(サーバサイドセッション、5.2節)
SESSION_COOKIE_NAME=knives_session
SESSION_TTL=24h
# 本番は必ずtrue(HTTPS前提)。ローカルでHTTP開発する場合のみfalseにする。
SESSION_COOKIE_SECURE=true

# click_events.ip_hash 用ソルト(推測困難な値を各環境で生成すること)
IP_HASH_SALT=

# OIDC/SAMLのclient_secret暗号化キー(idp_oidc_configs.client_secret_encrypted等)
CREDENTIAL_ENCRYPTION_KEY=

# メール送信(確認メール、3.4節のアカウント統合フロー用)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

# ログレベル
LOG_LEVEL=info
